! Window Geometry & Scrolling
XTerm*geometry:             96x32
XTerm*saveLines:            2000
XTerm*scrollBar:            false
XTerm*fastScroll:           true
XTerm*jumpScroll:           true
XTerm*scrollTtyOutput:      false
XTerm*scrollKey:            true

! Fonts & Rendering
XTerm*faceName:             Commit Mono
XTerm*faceSize:             13
XTerm*faceNameDoublesize:   DejaVu Sans Mono
XTerm*renderFont:           true
XTerm*scaleHeight:          1.0

! Security & Sandbox (Stops cat /dev/urandom from resizing or dumping HTML)
XTerm*allowWindowOps:       false
XTerm*printerControlMode:   0
XTerm*disallowedWindowOps:  20,21,Reset,SetXprop,SetWinLines,SetWinChars,SetIconName,SetTitle

! Selection & Clipboard (Restores Middle-Click)
XTerm*selectToClipboard:    false
XTerm*VT100.translations: #override \
    Shift <Key>Insert: insert-selection(CLIPBOARD)

! Cursor & Pointer
XTerm*cursorBlink:          false
XTerm*cursorUnderline:      true
XTerm*pointerBlank:         true
XTerm*pointerBlankDelay:    2

! Gruvbox (Dark) colorscheme
XTerm*background:           #282828
XTerm*foreground:           #ebdbb2
XTerm*cursorColor:          #ebdbb2

XTerm*color0:               #282828
XTerm*color8:               #928374
XTerm*color1:               #cc241d
XTerm*color9:               #fb4934
XTerm*color2:               #98971a
XTerm*color10:              #b8bb26
XTerm*color3:               #d79921
XTerm*color11:              #fabd2f
XTerm*color4:               #458588
XTerm*color12:              #83a598
XTerm*color5:               #b16286
XTerm*color13:              #d3869b
XTerm*color6:               #689d6a
XTerm*color14:              #8ec07c
XTerm*color7:               #a89984
XTerm*color15:              #fbf1c7
